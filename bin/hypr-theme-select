#!/usr/bin/env bash
# Apply one of the fixed, hand-tuned desktop theme profiles.
set -euo pipefail

theme="${1:-}"
template_root="$HOME/.config/hypr/themes/templates"

usage() {
    printf 'Usage: %s <theme>\n\nAvailable themes:\n  alpine       black terminals with warm sepia text\n  ink-wash     parchment terminals with dark ink text\n  gothic-rose  near-black terminals with ivory and dusty rose\n' "$0"
}

case "$theme" in
    alpine)
        background="#050403"; surface="#0c0a08"; surface_high="#17120f"
        foreground="#d4c3a7"; muted="#9b8b77"; primary="#b69c79"
        primary_container="#403426"; on_primary_container="#fffaf0"
        secondary="#c4ad8e"; tertiary="#8b9671"; outline="#756958"
        outline_variant="#362e27"; error="#d17b67"; selection="#554634"; on_primary="#120d09"
        ;;
    ink-wash)
        background="#f5eedc"; surface="#fbf4e4"; surface_high="#eee4cf"
        foreground="#243a3d"; muted="#66716d"; primary="#254448"
        primary_container="#d6c9a9"; on_primary_container="#102426"
        secondary="#786956"; tertiary="#546d69"; outline="#8e856f"
        outline_variant="#c6bda6"; error="#9e5147"; selection="#d8ccb0"; on_primary="#f7f2e6"
        ;;
    gothic-rose)
        background="#0b0a0a"; surface="#121010"; surface_high="#24201f"
        foreground="#e0d5c8"; muted="#a89688"; primary="#c0a69c"
        primary_container="#443735"; on_primary_container="#1b1413"
        secondary="#a99384"; tertiary="#9b7d77"; outline="#7c6d63"
        outline_variant="#332d2b"; error="#c4584f"; selection="#5b4945"; on_primary="#1b1413"
        ;;
    -l|--list)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac

for template in colors.lua dynamic.conf DynamicTheme.qml colors.css gtk-colors.css hyprlock-colors.conf dunstrc; do
    [[ -f "$template_root/$template" ]] || {
        printf 'Missing theme template: %s\n' "$template_root/$template" >&2
        exit 1
    }
done

background_hex="${background#\#}"
surface_hex="${surface#\#}"
surface_high_hex="${surface_high#\#}"
foreground_hex="${foreground#\#}"
muted_hex="${muted#\#}"
primary_hex="${primary#\#}"
primary_container_hex="${primary_container#\#}"
on_primary_container_hex="${on_primary_container#\#}"
secondary_hex="${secondary#\#}"
tertiary_hex="${tertiary#\#}"
outline_hex="${outline#\#}"
outline_variant_hex="${outline_variant#\#}"

render() {
    local template="$1" target="$2" temporary
    mkdir -p -- "$(dirname -- "$target")"
    temporary="$(mktemp "${target}.XXXXXX")"
    sed \
        -e "s|@background@|$background|g" \
        -e "s|@surface@|$surface|g" \
        -e "s|@surface_high@|$surface_high|g" \
        -e "s|@foreground@|$foreground|g" \
        -e "s|@muted@|$muted|g" \
        -e "s|@primary@|$primary|g" \
        -e "s|@primary_container@|$primary_container|g" \
        -e "s|@on_primary_container@|$on_primary_container|g" \
        -e "s|@secondary@|$secondary|g" \
        -e "s|@tertiary@|$tertiary|g" \
        -e "s|@outline@|$outline|g" \
        -e "s|@outline_variant@|$outline_variant|g" \
        -e "s|@error@|$error|g" \
        -e "s|@selection@|$selection|g" \
        -e "s|@on_primary@|$on_primary|g" \
        -e "s|@background_hex@|$background_hex|g" \
        -e "s|@surface_hex@|$surface_hex|g" \
        -e "s|@surface_high_hex@|$surface_high_hex|g" \
        -e "s|@foreground_hex@|$foreground_hex|g" \
        -e "s|@muted_hex@|$muted_hex|g" \
        -e "s|@primary_hex@|$primary_hex|g" \
        -e "s|@primary_container_hex@|$primary_container_hex|g" \
        -e "s|@on_primary_container_hex@|$on_primary_container_hex|g" \
        -e "s|@secondary_hex@|$secondary_hex|g" \
        -e "s|@tertiary_hex@|$tertiary_hex|g" \
        -e "s|@outline_hex@|$outline_hex|g" \
        -e "s|@outline_variant_hex@|$outline_variant_hex|g" \
        "$template_root/$template" > "$temporary"
    chmod 0644 -- "$temporary"
    mv -- "$temporary" "$target"
}

render colors.lua "$HOME/.config/hypr/colors.lua"
render dynamic.conf "$HOME/.config/kitty/dynamic.conf"
render colors.css "$HOME/.config/wofi/colors.css"
render DynamicTheme.qml "$HOME/.config/quickshell/DynamicTheme.qml"
render hyprlock-colors.conf "$HOME/.config/hypr/hyprlock-colors.conf"
render dunstrc "$HOME/.config/dunst/dunstrc"
render gtk-colors.css "$HOME/.config/gtk-3.0/matugen-colors.css"
render gtk-colors.css "$HOME/.config/gtk-4.0/matugen-colors.css"
printf '%s\n' "$theme" > "$HOME/.config/hypr/active-theme"

if [[ "${HYPR_THEME_NO_RELOAD:-0}" != "1" ]]; then
    hyprctl reload >/dev/null 2>&1 || true
    dunstctl reload >/dev/null 2>&1 || true
    pkill -SIGUSR1 -x kitty >/dev/null 2>&1 || true

    # Quickshell watches its config on current versions; restarting only if it is
    # already running makes the palette update immediate while preserving the bar.
    if pgrep -x quickshell >/dev/null 2>&1; then
        quickshell kill >/dev/null 2>&1 || true
        nohup quickshell >/dev/null 2>&1 &
    fi

    if command -v dunstify >/dev/null 2>&1; then
        dunstify -a "Theme" -u low -r 7705 -t 3000 "Theme applied" "$theme" >/dev/null 2>&1 || true
    fi
fi
