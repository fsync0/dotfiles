# Optional Oh My Zsh integration keeps its Git aliases when it is installed.
if [[ -r "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
    export ZSH="$HOME/.oh-my-zsh"
    ZSH_THEME=""
    plugins=(
        git
        fzf
        history-substring-search
        sudo
        command-not-found
        colored-man-pages
        z
        web-search
        copyfile
        copypath
        zsh-autosuggestions
    )
    source "$ZSH/oh-my-zsh.sh"

    # Let `web_search query` use Google while retaining explicit engines such
    # as `web_search youtube query`.
    if (( $+functions[web_search] )); then
        functions[_omz_web_search]=$functions[web_search]
        function web_search() {
            local -a engines=(
                google bing brave yahoo duckduckgo startpage yandex github baidu ecosia
                goodreads qwant givero stackoverflow wolframalpha archive scholar ask youtube
                deepl dockerhub gems npmpkg packagist gopkg maven pypi aur archwiki wikipedia
                chatgpt grok claudeai reddit ppai rscrate rsdoc
            )

            if (( $# == 0 )); then
                _omz_web_search google
            elif (( ${engines[(Ie)$1]} )); then
                _omz_web_search "$@"
            else
                _omz_web_search google "$@"
            fi
        }
    fi
fi

export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

if (( $+commands[eza] )); then
    alias ls='eza --color=auto --group-directories-first'
    alias ll='eza --long --all --icons=auto --git --group-directories-first'
    alias la='eza --long --all --icons=auto --group-directories-first'
else
    alias ls='ls --color=auto'
    alias ll='ls --color=auto -lah'
    alias la='ls --color=auto -A'
fi

p10k_theme="$HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ -r "$p10k_theme" ]] || p10k_theme="$HOME/.oh-my-zsh/custom/themes/powerlevel10k/powerlevel10k.zsh-theme"
[[ -r "$p10k_theme" ]] && source "$p10k_theme"
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
