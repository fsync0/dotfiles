source ~/.config/vim/wallpaper-theme.vim
set number
set fillchars+=vert:│

let mapleader = ' '

if has('persistent_undo')
  let s:undo_dir = expand('~/.local/state/vim/undo')
  if !isdirectory(s:undo_dir)
    call mkdir(s:undo_dir, 'p', 0700)
  endif
  let &undodir = s:undo_dir . '//'
  set undofile
endif

" vim-startify is installed as a native Vim package by setup.sh.
" Its default screen appears when Vim opens without a file.
let g:startify_change_to_vcs_root = 0
let g:startify_lists = [
      \ { 'type': 'dir', 'header': ['   Current directory'] },
      \ ]
nnoremap <silent> <leader>s :Startify<CR>
nnoremap <silent> <leader><Bar> :vsplit<CR>
nnoremap <silent> <leader>- :split<CR>
nnoremap <silent> <leader>ff :Files<CR>
nnoremap <silent> <leader>fg :Rg<CR>
nnoremap <silent> <leader>fb :Buffers<CR>
nnoremap <silent> <leader>g :Git<CR>
nnoremap <silent> <leader>u :UndotreeToggle<CR>

" vim-which-key: show the available leader mappings after Space.
set timeout
set timeoutlen=500
let g:which_key_hspace = 4
let g:which_key_map = {
      \ 'f': {
      \   'name': '+find',
      \   'f': 'files',
      \   'g': 'text search',
      \   'b': 'buffers',
      \ },
      \ 'g': 'git status',
      \ 'u': 'undo tree',
      \ 's': 'start dashboard',
      \ '|': 'vertical split',
      \ '-': 'horizontal split',
      \ 'r': {
      \   'name': '+language',
      \   'n': 'rename symbol',
      \ },
      \ 'c': {
      \   'name': '+code',
      \   'a': 'code action',
      \ },
      \ 'e': 'line diagnostic',
      \ }
let g:which_key_floating_opts_explicit = {
      \ 'border': [1, 1, 1, 1],
      \ 'borderchars': ['─', '│', '─', '│', '╭', '╮', '╯', '╰'],
      \ 'borderhighlight': ['WhichKeyBorder'],
      \ 'padding': [0, 1, 0, 1],
      \ }
nnoremap <silent> <leader> :<C-u>WhichKey '<Space>'<CR>
vnoremap <silent> <leader> :<C-u>WhichKeyVisual '<Space>'<CR>

" Native Vim packages load just after vimrc, so register the guide on VimEnter.
function! s:register_which_key() abort
  if exists(':WhichKey') == 2
    call which_key#register('<Space>', 'g:which_key_map')
  endif
endfunction

augroup VimWhichKeySetup
  autocmd!
  autocmd VimEnter * call <SID>register_which_key()
augroup END
call s:register_which_key()

" LSP and completion
set completeopt=menuone,noinsert,noselect
set pumopt=height:5,opacity:100,border:single
let g:lsp_diagnostics_signs_enabled = 1
let g:lsp_diagnostics_virtual_text_enabled = 0
let g:lsp_diagnostics_echo_cursor = 0
let g:lsp_diagnostics_float_cursor = 0
inoremap <expr> <Tab> pumvisible() ? "\<C-n>" : "\<Tab>"
inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<C-h>"
inoremap <expr> <CR> pumvisible() ? "\<C-y>" : "\<CR>"

function! s:find_lsp_executable(name) abort
  let l:system_path = exepath(a:name)
  if !empty(l:system_path)
    return l:system_path
  endif

  let l:mason_path = expand('~/.local/share/nvim/mason/bin/' . a:name)
  if executable(l:mason_path)
    return l:mason_path
  endif

  " rustup tools live here when Vim is started outside an interactive shell.
  let l:cargo_path = expand('~/.cargo/bin/' . a:name)
  return executable(l:cargo_path) ? l:cargo_path : ''
endfunction

let s:lsp_servers = {
      \ 'pyright': s:find_lsp_executable('pyright-langserver'),
      \ 'gopls': s:find_lsp_executable('gopls'),
      \ 'rust_analyzer': s:find_lsp_executable('rust-analyzer'),
      \ 'clangd': s:find_lsp_executable('clangd'),
      \ }

function! s:rust_analyzer_workspace_config(server_info) abort
  let l:file_path = lsp#utils#get_buffer_path()
  if empty(l:file_path)
    return {}
  endif

  let l:search_path = fnamemodify(l:file_path, ':h') . ';'
  let l:project_file = findfile('Cargo.toml', l:search_path)
  if empty(l:project_file)
    let l:project_file = findfile('rust-project.json', l:search_path)
  endif

  " A Cargo manifest provides full project information.  For a lone .rs file,
  " explicitly link that file so rust-analyzer treats it as a standalone crate.
  let l:project_file = empty(l:project_file) ? l:file_path : fnamemodify(l:project_file, ':p')
  return {'rust-analyzer': {'linkedProjects': [l:project_file]}}
endfunction

function! s:register_lsp_servers() abort
  if !empty(s:lsp_servers.pyright)
    call lsp#register_server({
          \ 'name': 'pyright',
          \ 'cmd': {server_info -> [s:lsp_servers.pyright, '--stdio']},
          \ 'allowlist': ['python'],
          \ })
  endif

  if !empty(s:lsp_servers.gopls)
    call lsp#register_server({
          \ 'name': 'gopls',
          \ 'cmd': {server_info -> [s:lsp_servers.gopls]},
          \ 'allowlist': ['go', 'gomod', 'gowork'],
          \ })
  endif

  if !empty(s:lsp_servers.rust_analyzer)
    call lsp#register_server({
          \ 'name': 'rust-analyzer',
          \ 'cmd': {server_info -> [s:lsp_servers.rust_analyzer]},
          \ 'allowlist': ['rust'],
          \ 'workspace_config': function('<SID>rust_analyzer_workspace_config'),
          \ })
  endif

  if !empty(s:lsp_servers.clangd)
    call lsp#register_server({
          \ 'name': 'clangd',
          \ 'cmd': {server_info -> [s:lsp_servers.clangd]},
          \ 'allowlist': ['c', 'cpp', 'objc', 'objcpp'],
          \ })
  endif
endfunction

function! s:on_lsp_buffer_enabled() abort
  setlocal omnifunc=lsp#complete
  setlocal signcolumn=yes
  " rust-analyzer can still be indexing while the first completion request is
  " sent.  Refresh on each typed character so a late response is retried.
  if &l:filetype ==# 'rust'
    let b:asyncomplete_refresh_always = 1
    let b:asyncomplete_min_chars = 1
  endif
  nmap <buffer> gd <plug>(lsp-definition)
  nmap <buffer> gr <plug>(lsp-references)
  nmap <buffer> K <plug>(lsp-hover)
  nmap <buffer> <leader>rn <plug>(lsp-rename)
  nmap <buffer> <leader>ca <plug>(lsp-code-action)
  nmap <buffer> [d <plug>(lsp-previous-diagnostic)
  nmap <buffer> ]d <plug>(lsp-next-diagnostic)
  nnoremap <silent> <buffer> <leader>e :<C-u>call <SID>show_lsp_diagnostic()<CR>
endfunction

function! s:show_lsp_diagnostic() abort
  let l:uri = lsp#utils#get_buffer_uri(bufnr('%'))
  let l:responses = lsp#internal#diagnostics#state#_get_all_diagnostics_grouped_by_server_for_uri(l:uri)
  let l:current_line = line('.')
  let l:messages = []

  for l:response in values(l:responses)
    for l:diagnostic in get(get(l:response, 'params', {}), 'diagnostics', [])
      let [l:start_line, l:start_col] = lsp#utils#position#lsp_to_vim('%', l:diagnostic['range']['start'])
      let [l:end_line, l:end_col] = lsp#utils#position#lsp_to_vim('%', l:diagnostic['range']['end'])
      if l:current_line >= l:start_line && l:current_line <= l:end_line
        call add(l:messages, get(l:diagnostic, 'message', 'No diagnostic message available.'))
      endif
    endfor
  endfor

  echo empty(l:messages) ? 'No diagnostic on this line.' : join(l:messages, ' | ')
endfunction

augroup VimLspSetup
  autocmd!
  autocmd User lsp_setup call s:register_lsp_servers()
  autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
augroup END
