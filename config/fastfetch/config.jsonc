{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
      "top": 3,
      "right": 2
    }
  },

  "display": {
    "separator": ": ",
    "key": {
      "width": 11
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "abdessamad@fsync0"
    },
    {
      "type": "custom",
      "format": "-----------------"
    },
    "os",
    "host",
    "kernel",
    "shell",
    "uptime",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    {
      "type": "battery",
      "key": "Battery"
    },
    "locale"
  ]
}
